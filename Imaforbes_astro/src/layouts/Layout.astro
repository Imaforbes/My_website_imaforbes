---
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import Breadcrumbs from '../components/Breadcrumbs.jsx';
import BrowserSupport from '../components/BrowserSupport.jsx';
import ScrollToTopButton from '../components/ScrollToTopButton.jsx';
import '../styles/index.css';
import '../i18n.js';

const { title = "Imaforbes Portfolio", description = "Portfolio profesional de Imaforbes - Desarrollo web y diseño", image = '/img/Logo.png', url = '', isAdmin = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={isAdmin ? "noindex, nofollow" : "index, follow"} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url || Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/png" href="/img/Logo.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;800&family=Inter:wght@300;400;500;600&display=swap" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <title>{title}</title>

    <script is:inline>
      // Apply theme immediately to prevent flash
      (function () {
        try {
          var savedTheme = localStorage.getItem('app_theme');
          var theme = 'dark'; // Default
          
          if (savedTheme === 'light') {
            theme = 'light';
          } else if (savedTheme === 'dark') {
            theme = 'dark';
          } else if (savedTheme === 'auto') {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          
          var root = document.documentElement;
          root.classList.add(theme);
          root.classList.remove(theme === 'dark' ? 'light' : 'dark');
          
          var addBodyClass = function() {
            document.body.classList.remove('light-theme', 'dark-theme', 'auto-theme');
            document.body.classList.add(theme + '-theme');
          };
          
          if (document.body) {
            addBodyClass();
          } else {
            document.addEventListener('DOMContentLoaded', addBodyClass);
          }
        } catch (e) {
          // Fallback if localStorage is blocked
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <BrowserSupport client:only="react" />
    
    <div class="app-wrapper" style="display: flex; flex-direction: column; min-height: 100svh;">
      {!isAdmin && <Header client:load currentPath={Astro.url.pathname} />}
      {!isAdmin && <Breadcrumbs client:idle currentPath={Astro.url.pathname} />}
      
      <main style={`flex-grow: 1; padding-top: ${!isAdmin ? '5rem' : '0'};`}>
        <slot />
      </main>
      
      {!isAdmin && <Footer client:visible currentPath={Astro.url.pathname} />}
      {!isAdmin && <ScrollToTopButton client:idle />}
    </div>
  </body>
</html>
