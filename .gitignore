# ========================================
# Sitio_Web_imaforbes - Global .gitignore
# Applies to frontend, docs, and legacy archives.
# ========================================

# --- Environment / secrets ---
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example

# --- Dependencies ---
**/node_modules/
**/vendor/

# --- Builds / caches / artifacts ---
**/dist/
**/build/
**/.astro/
**/.next/
**/.vercel/
**/out/
**/*.log

# --- Runtime storage / temp ---
**/storage/*
**/tmp/*
**/cache/*
**/.well-known/

# --- OS / editor ---
.DS_Store
**/.DS_Store
.vscode/
.idea/

# --- Database Dumps (except documented migrations in docs/) ---
*.sql
!**/docs/*.sql

# --- Legacy / Obsolete folders (kept locally, never tracked in Git) ---
_legacy_code/
api_db/
Imaforbes_frontend/
Imaforbes_Api_backend/
